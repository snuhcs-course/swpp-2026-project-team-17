# NoTouch 온라인 예측용 서버 환경변수 예제
# 제공자: OpenAI / 모델: GPT-6 Luna. 실제 API 키는 입력하지 않았습니다.
# server/.env에 API 키를 직접 입력하고 사용할 때 활성화해 주세요.
# 실제 비밀키는 이 예제 파일이나 Android 앱에 넣지 않습니다.
# 중계 서버가 이 파일의 복사본인 server/.env를 읽습니다. Android 앱은 읽지 않습니다.
# 값을 채운 뒤에도 서버 실행·앱 연결 주소 설정·사용자 동의가 있어야 예측합니다.

# API 키·서버 주소 설정 후 활성화합니다. 앱에서는 별도의 사용자 동의도 필요합니다.
AI_PREDICTION_ENABLED=false

# OpenAI Responses API 사용
AI_PROVIDER=openai

# 사용자가 선택한 모델
AI_MODEL=gpt-6-luna

# TODO: API 키 미입력 — 실제 키는 서버에서만 사용합니다.
AI_API_KEY=

# OpenAI API 기본 주소. 서버가 뒤에 /responses를 붙입니다.
# Android 앱이 연결할 중계 서버 주소와는 별개입니다.
AI_API_BASE_URL=https://api.openai.com/v1

# 짧은 자동완성 요청에 맞춰 추가 추론을 사용하지 않습니다.
AI_REASONING_EFFORT=none
