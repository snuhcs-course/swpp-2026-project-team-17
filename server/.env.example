# NoTouch 온라인 예측용 서버 환경변수 예제
# TODO: AI 제공자와 모델은 아직 미정이며, API 키도 입력하지 않았습니다.
# 나중에 server/.env의 아래 빈 항목을 채워 주세요.
# 실제 비밀키는 이 예제 파일이나 Android 앱에 넣지 않습니다.
# 중계 서버가 이 파일의 복사본인 server/.env를 읽습니다. Android 앱은 읽지 않습니다.
# 값을 채운 뒤에도 서버 실행·앱 연결 주소 설정·사용자 동의가 있어야 예측합니다.

# TODO: 온라인 예측 연결 구현 및 사용자 동의 처리가 준비된 뒤 활성화합니다.
AI_PREDICTION_ENABLED=false

# TODO: 사용할 AI 제공자 미정
AI_PROVIDER=

# TODO: 사용할 모델 미정 — 특정 모델을 기본값으로 지정하지 않습니다.
AI_MODEL=

# TODO: API 키 미입력 — 실제 키는 서버에서만 사용합니다.
AI_API_KEY=

# TODO: AI 제공자가 정해지면 해당 제공자의 API 기본 주소를 입력합니다.
# Android 앱이 연결할 중계 서버 주소와는 별개입니다.
AI_API_BASE_URL=

# TODO: 모델 확정 후 필요할 때만 추론 설정을 입력합니다. 미정이므로 비워 둡니다.
AI_REASONING_EFFORT=
